# ====================================================================
# Dockerfile.multistage: Полная сборка внутри контейнера с нуля
# ====================================================================
FROM rust:1.80-slim-bookworm AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
# Кэширование слоя зависимостей
RUN mkdir src && echo "fn main() {}" > src/main.rs && cargo build --release && rm -rf src

COPY src ./src
RUN touch src/main.rs && cargo build --release

# Финальный runtime образ
FROM debian:bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    sqlite3 \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/telegram_bot /app/telegram_bot
RUN chmod +x /app/telegram_bot

RUN mkdir -p /app/data
VOLUME ["/app/data"]
ENV DATABASE_URL="sqlite:///app/data/bot.db?mode=rwc"
ENV RUST_LOG="info"

CMD ["/app/telegram_bot"]
